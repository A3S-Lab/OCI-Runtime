{
  "ociVersion": "1.3.0",
  "process": {
    "terminal": false,
    "user": {
      "uid": 0,
      "gid": 0
    },
    "args": [
      "/bin/sh",
      "-c",
      "trap 'exit 0' TERM; test \"$$\" -eq 1 && test \"$(readlink /proc/self/ns/pid)\" = \"$(readlink /proc/1/ns/pid)\" || exit 91; printf 'a3s-oci-create-start-v1\\n' > /.a3s-oci-create-start-smoke; while :; do sleep 1; done"
    ],
    "env": [
      "PATH=/bin:/usr/bin:/sbin:/usr/sbin"
    ],
    "cwd": "/",
    "noNewPrivileges": true
  },
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "hostname": "a3s-soak",
  "domainname": "runtime.test",
  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc",
      "options": [
        "nosuid",
        "noexec",
        "nodev"
      ]
    }
  ],
  "linux": {
    "namespaces": [
      {
        "type": "uts"
      },
      {
        "type": "mount"
      },
      {
        "type": "ipc"
      },
      {
        "type": "network"
      },
      {
        "type": "cgroup"
      },
      {
        "type": "pid"
      }
    ]
  }
}
