{
  "schema_version": "a3s.oci.upstream-runtime-tools-lock.v1",
  "repository": "https://github.com/opencontainers/runtime-tools.git",
  "commit": "8a4db579f5c88af5a0d036fad34bddc9c1f703f3",
  "version": "0.9.0",
  "runtime_spec": {
    "version": "1.3.0",
    "module_sum": "h1:YZupQUdctfhpZy3TM39nN9Ika5CBWT5diQ8ibYCRkxg="
  },
  "build": {
    "go_version": "go1.24.0",
    "cgo_enabled": false,
    "trimpath": true,
    "buildvcs": false,
    "static_elf": true
  },
  "upstream_interface": "oci-runtime-command-line-interface",
  "integration": {
    "bundle_validation": "native-linux-package",
    "lifecycle_validation": "native-linux-core-preflight-v1"
  },
  "lifecycle": {
    "profile": "native-linux-core-v1",
    "validated_architectures": [],
    "preflight_architectures": [
      "x86_64"
    ],
    "blockers": {
      "x86_64": "unsupported-upstream-seccomp-compat-architectures",
      "aarch64": "missing-upstream-aarch64-rootfs"
    },
    "tests": [
      "create",
      "state",
      "start",
      "kill",
      "killsig",
      "kill_no_effect",
      "delete",
      "pidfile",
      "config_updates_without_affect"
    ],
    "limitations": [
      "stdio-descriptor-transport",
      "terminal-console-socket",
      "listen-fds",
      "aarch64-upstream-rootfs"
    ]
  }
}
