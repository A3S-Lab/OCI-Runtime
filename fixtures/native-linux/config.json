{
  "ociVersion": "1.3.0",
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "process": {
    "terminal": false,
    "user": {
      "uid": 0,
      "gid": 0
    },
    "args": [
      "/bin/sh",
      "-c",
      "set -eu; /bin/busybox awk 'NR == 1 && $1 == 0 && $2 == 100000 && $3 == 65536 { ok = 1 } END { exit !ok }' /proc/self/uid_map; /bin/busybox awk 'NR == 1 && $1 == 0 && $2 == 200000 && $3 == 65536 { ok = 1 } END { exit !ok }' /proc/self/gid_map; /bin/busybox awk '$1 == \"monotonic\" && $2 == 3600 && $3 == 0 { ok = 1 } END { exit !ok }' /proc/self/timens_offsets; /bin/busybox awk '$1 == \"boottime\" && $2 == 7200 && $3 == 0 { ok = 1 } END { exit !ok }' /proc/self/timens_offsets; printf 'a3s-oci-native-box-mapping-v1\\n' > /.a3s-oci-native-smoke; exec /bin/busybox sleep 300"
    ],
    "env": [
      "PATH=/bin"
    ],
    "cwd": "/",
    "noNewPrivileges": true
  },
  "hostname": "a3s-native",
  "domainname": "runtime.test",
  "mounts": [
    {
      "destination": "/proc",
      "type": "proc",
      "source": "proc",
      "options": [
        "nosuid",
        "noexec",
        "nodev"
      ]
    }
  ],
  "linux": {
    "cgroupsPath": "a3s-oci-smoke-a",
    "namespaces": [
      {
        "type": "uts"
      },
      {
        "type": "mount"
      },
      {
        "type": "ipc"
      },
      {
        "type": "network"
      },
      {
        "type": "cgroup"
      },
      {
        "type": "pid"
      },
      {
        "type": "user"
      },
      {
        "type": "time"
      }
    ],
    "uidMappings": [
      {
        "containerID": 0,
        "hostID": 100000,
        "size": 65536
      }
    ],
    "gidMappings": [
      {
        "containerID": 0,
        "hostID": 200000,
        "size": 65536
      }
    ],
    "timeOffsets": {
      "monotonic": {
        "secs": 3600,
        "nanosecs": 0
      },
      "boottime": {
        "secs": 7200,
        "nanosecs": 0
      }
    }
  }
}
